# ── Anthropic ────────────────────────────────────────────────────────────────
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Database (Supabase - free) ────────────────────────────────────────────────
# Get from: supabase.com → New Project → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# ── Auth ─────────────────────────────────────────────────────────────────────
# Your deployed URL (no trailing slash)
NEXTAUTH_URL=https://your-app.vercel.app
# Random secret - generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-here

# ── Stripe ───────────────────────────────────────────────────────────────────
# Get from: dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...
# Get from: dashboard.stripe.com → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Get from: dashboard.stripe.com → Products → Create product → Price ID
STRIPE_PRO_PRICE_ID=price_...
STRIPE_TRADER_PRICE_ID=price_...

# ── Email (Resend - free tier) ────────────────────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY=re_...
# Your sending email (must be verified in Resend)
EMAIL_FROM=alerts@yourdomain.com

# ── Cron security ────────────────────────────────────────────────────────────
# Random string to secure the cron endpoint
# Generate with: openssl rand -base64 32
CRON_SECRET=your-cron-secret-here

# ── Supabase Storage (for chart image uploads) ────────────────────────────────
# Same Supabase project you already created for the database
# Get from: supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Setup: In Supabase Dashboard → Storage → Create bucket named "trade-media"
# Set bucket to Public. Done.
