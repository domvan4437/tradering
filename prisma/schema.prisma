generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  password             String
  name                 String?
  username             String?               @unique
  bio                  String?
  createdAt            DateTime              @default(now())
  stripeCustomerId     String?               @unique
  subscriptionId       String?               @unique
  subscriptionStatus   String?
  plan                 String                @default("free")
  trialEndsAt          DateTime?
  screeningsToday      Int                   @default(0)
  screeningsReset      DateTime              @default(now())
  isPublic             Boolean               @default(false)
  theme                String                @default("dark-gold")
  dashboardLayout      Json?
  customFields         Json?
  badgeEarnedAt        DateTime?
  displayName          String?
  primaryAssets        String?
  profileSlug          String?               @unique
  profileVisibility    String                @default("private")
  propFirmInterest     Boolean               @default(false)
  propFirmPartnerId    String?
  propFirmReferredAt   DateTime?
  tradingStyle         String?
  twitterHandle        String?
  verifiedBadge        Boolean               @default(false)
  aiConversations      AIConversation[]
  alerts               Alert[]
  brokerConnections    BrokerConnection[]
  brokerTrades         BrokerTrade[]
  cotAlerts            COTAlert[]
  calendarNotes        CalendarNote[]
  checklists           Checklist[]
  posts                CommunityPost[]
  creatorPayouts       CreatorPayout[]
  sentMessages         DirectMessage[]       @relation("SentMessages")
  receivedMessages     DirectMessage[]       @relation("ReceivedMessages")
  ownedGroups          Group[]               @relation("OwnedGroups")
  groupMembers         GroupMember[]
  groupMemberships     GroupMembership[]
  groupMessages        GroupMessage[]
  h2hChallenges        H2HMatch[]            @relation("H2HChallenger")
  h2hOpponents         H2HMatch[]            @relation("H2HOpponent")
  ideas                Idea[]
  leaderboardSnapshots LeaderboardSnapshot[] @relation("LeaderboardSnapshots")
  notes                Note[]
  positions            Position[]
  postLikes            PostLike[]
  priceAlerts          PriceAlert[]
  propFirmReferrals    PropFirmReferral[]    @relation("PropFirmReferrals")
  screenerTemplates    ScreenerTemplate[]    @relation("UserScreeners")
  screenings           Screening[]
  socialComments       SocialComment[]
  socialPosts          SocialPost[]
  createdTournaments   Tournament[]          @relation("CreatedTournaments")
  tournamentEntries    TournamentEntry[]
  tradeCalls           TradeCall[]
  tradeIdeas           TradeIdea[]           @relation("AuthoredIdeas")
  tradeMedia           TradeMedia[]
  tradePlans           TradePlan[]
  consistency          TraderConsistency?
  followers            UserFollow[]          @relation("Followers")
  following            UserFollow[]          @relation("Following")
  watchlist            WatchlistItem[]
  weeklyReviews        WeeklyReview[]
}

model Screening {
  id              String   @id @default(cuid())
  userId          String
  commodity       String
  direction       String?
  passed          Boolean
  stageFailed     String?
  stagesCompleted Int
  price           String?
  notes           String?
  outcome         String?
  pnl             Float?
  marketData      Json?
  results         Json?
  tags            String[]
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  commodity String
  notes     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commodity])
}

model Alert {
  id        String    @id @default(cuid())
  userId    String
  type      String
  enabled   Boolean   @default(true)
  lastSent  DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Position {
  id           String    @id @default(cuid())
  userId       String
  symbol       String
  name         String
  direction    String
  entryPrice   Float
  currentPrice Float?
  stopPrice    Float?
  targetPrice  Float?
  contracts    Int       @default(1)
  contractSize Float     @default(1)
  status       String    @default("open")
  exitPrice    Float?
  exitDate     DateTime?
  pnl          Float?
  notes        String?
  tags         String[]
  openedAt     DateTime  @default(now())
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Idea {
  id         String   @id @default(cuid())
  userId     String
  title      String
  symbol     String?
  direction  String?
  timeframe  String?
  status     String   @default("watching")
  thesis     String?
  entry      String?
  stop       String?
  target     String?
  confidence Int?
  tags       String[]
  isPublic   Boolean  @default(false)
  imageUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PriceAlert {
  id          String    @id @default(cuid())
  userId      String
  symbol      String
  name        String
  condition   String
  value       Float?
  message     String?
  triggered   Boolean   @default(false)
  triggeredAt DateTime?
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommunityPost {
  id          String   @id @default(cuid())
  userId      String
  symbol      String
  direction   String?
  title       String
  body        String?
  passed      Boolean?
  cotIndex    Int?
  seasonal    Float?
  likes       Int      @default(0)
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Checklist {
  id        String          @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ChecklistItem[]
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  label       String
  order       Int       @default(0)
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String   @default("")
  tags      String[]
  isPinned  Boolean  @default(false)
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TradeMedia {
  id          String   @id @default(cuid())
  userId      String
  screeningId String?
  positionId  String?
  url         String
  caption     String?
  type        String   @default("image")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeeklyReview {
  id            String   @id @default(cuid())
  userId        String
  weekOf        DateTime
  whatWorked    String?
  whatDidnt     String?
  biggestLesson String?
  nextWeekFocus String?
  mentalState   String?
  rulesFollowed Int?
  totalTrades   Int?
  pnl           Float?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  title     String      @default("New Conversation")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model CalendarNote {
  id        String   @id @default(cuid())
  userId    String
  date      String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model COTAlert {
  id          String    @id @default(cuid())
  userId      String
  commodity   String
  condition   String
  threshold   Int
  label       String?
  enabled     Boolean   @default(true)
  triggered   Boolean   @default(false)
  triggeredAt DateTime?
  lastChecked DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TradePlan {
  id              String   @id @default(cuid())
  userId          String
  commodity       String
  direction       String
  entry           String?
  stop            String?
  target          String?
  riskReward      String?
  thesis          String?
  cotContext      String?
  seasonalContext String?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SocialPost {
  id        String          @id @default(cuid())
  userId    String
  content   String
  imageUrl  String?
  assetTag  String?
  direction String?
  likes     Int             @default(0)
  reposts   Int             @default(0)
  isPublic  Boolean         @default(true)
  groupId   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  postLikes PostLike[]
  comments  SocialComment[]
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SocialComment {
  id        String     @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime   @default(now())
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PostLike {
  id        String     @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime   @default(now())
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model DirectMessage {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  fileName   String?
  fileUrl    String?
  imageUrl   String?
  fromUser   User     @relation("SentMessages", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("ReceivedMessages", fields: [toUserId], references: [id], onDelete: Cascade)
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Group {
  id           String            @id @default(cuid())
  ownerId      String
  name         String
  slug         String            @unique
  description  String?
  imageUrl     String?
  price        Float             @default(0)
  currency     String            @default("usd")
  platformFee  Float             @default(0.05)
  isPublic     Boolean           @default(true)
  memberCount  Int               @default(0)
  category     String?
  createdAt    DateTime          @default(now())
  isPrivate    Boolean           @default(false)
  monthlyPrice Float             @default(0)
  owner        User              @relation("OwnedGroups", fields: [ownerId], references: [id], onDelete: Cascade)
  channels     GroupChannel[]
  courses      GroupCourse[]
  members      GroupMember[]
  memberships  GroupMembership[]
  tradeIdeas   TradeIdea[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model GroupChannel {
  id        String         @id @default(cuid())
  groupId   String
  name      String
  type      String         @default("chat")
  order     Int            @default(0)
  createdAt DateTime       @default(now())
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  messages  GroupMessage[]
}

model GroupMessage {
  id        String       @id @default(cuid())
  channelId String
  userId    String
  content   String
  imageUrl  String?
  createdAt DateTime     @default(now())
  channel   GroupChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GroupCourse {
  id          String         @id @default(cuid())
  groupId     String
  title       String
  description String?
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  lessons     CourseLesson[]
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model CourseLesson {
  id        String      @id @default(cuid())
  courseId  String
  title     String
  content   String      @default("")
  videoUrl  String?
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  course    GroupCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Tournament {
  id               String            @id @default(cuid())
  creatorId        String
  name             String
  description      String?
  type             String            @default("tournament")
  status           String            @default("open")
  assetClasses     String[]
  maxCallsPerDay   Int               @default(3)
  startDate        DateTime
  endDate          DateTime
  buyIn            Float             @default(0)
  prizePool        Float             @default(0)
  payoutStructure  Json?
  maxTeams         Int?
  minTeams         Int               @default(2)
  platformFee      Float             @default(0.05)
  createdAt        DateTime          @default(now())
  allowedAssets    String?
  maxHoldHours     Int?
  maxRiskPct       Float?
  maxTradesPerWeek Int?
  minHoldHours     Int?
  minRiskReward    Float?
  requireStopLoss  Boolean           @default(true)
  requireTarget    Boolean           @default(true)
  traderStyle      String?
  h2hMatches       H2HMatch[]
  creator          User              @relation("CreatedTournaments", fields: [creatorId], references: [id], onDelete: Cascade)
  entries          TournamentEntry[]
  calls            TradeCall[]
}

model H2HMatch {
  id              String     @id @default(cuid())
  tournamentId    String
  challengerId    String
  opponentId      String?
  status          String     @default("waiting")
  winnerId        String?
  challengerScore Float      @default(0)
  opponentScore   Float      @default(0)
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime   @default(now())
  challenger      User       @relation("H2HChallenger", fields: [challengerId], references: [id])
  opponent        User?      @relation("H2HOpponent", fields: [opponentId], references: [id])
  tournament      Tournament @relation(fields: [tournamentId], references: [id])
}

model TraderConsistency {
  id               String   @id @default(cuid())
  userId           String   @unique
  totalTrades      Int      @default(0)
  winRate          Float    @default(0)
  avgRR            Float    @default(0)
  avgHoldHours     Float    @default(0)
  traderStyle      String?
  consistencyScore Float    @default(0)
  lastUpdated      DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id])
}

model TournamentEntry {
  id             String      @id @default(cuid())
  tournamentId   String
  groupId        String?
  userId         String
  teamName       String?
  score          Float       @default(0)
  rank           Int?
  paid           Boolean     @default(false)
  paidOut        Boolean     @default(false)
  totalDollarPnL Float       @default(0)
  autoBrokerSync Boolean     @default(false)
  joinedAt       DateTime    @default(now())
  tournament     Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  calls          TradeCall[]

  @@unique([tournamentId, userId])
}

model TradeCall {
  id               String          @id @default(cuid())
  entryId          String
  tournamentId     String
  userId           String
  asset            String
  symbol           String
  direction        String
  entryPrice       Float
  stopPrice        Float
  targetPrice      Float
  currentPrice     Float?
  contractSize     Float           @default(1)
  contracts        Int             @default(1)
  dollarRisk       Float?
  dollarTarget     Float?
  dollarPnL        Float?
  isRealMoney      Boolean         @default(false)
  status           String          @default("open")
  rMultiple        Float?
  points           Float           @default(0)
  submittedAt      DateTime        @default(now())
  resolvedAt       DateTime?
  expiresAt        DateTime?
  closeTimestamp   DateTime?
  disqualReason    String?
  entryTimestamp   DateTime?
  holdHours        Float?
  riskPct          Float?
  stopLoss         Float?
  takeProfit       Float?
  validationStatus String          @default("pending")
  consistencyDelta Float?
  entry            TournamentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tournament       Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BrokerConnection {
  id           String        @id @default(cuid())
  userId       String
  broker       String
  label        String?
  apiKey       String?
  apiSecret    String?
  accountId    String?
  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?
  status       String        @default("connected")
  lastSynced   DateTime?
  autoCompete  Boolean       @default(true)
  showPnL      Boolean       @default(false)
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerTrades BrokerTrade[]
}

model BrokerTrade {
  id            String           @id @default(cuid())
  connectionId  String
  userId        String
  brokerTradeId String
  asset         String
  symbol        String
  direction     String
  entryPrice    Float
  exitPrice     Float?
  stopPrice     Float?
  targetPrice   Float?
  quantity      Float            @default(1)
  contractSize  Float            @default(1)
  realizedPnL   Float?
  status        String           @default("open")
  openedAt      DateTime
  closedAt      DateTime?
  tradeCallId   String?
  createdAt     DateTime         @default(now())
  connection    BrokerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([connectionId, brokerTradeId])
}

model GroupMembership {
  id         String    @id @default(cuid())
  groupId    String
  userId     String
  monthlyFee Float     @default(0)
  status     String    @default("active")
  joinedAt   DateTime  @default(now())
  renewsAt   DateTime?
  group      Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model CreatorPayout {
  id          String   @id @default(cuid())
  creatorId   String
  amount      Float
  type        String
  sourceId    String?
  description String?
  paidOut     Boolean  @default(false)
  createdAt   DateTime @default(now())
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

model ScreenerTemplate {
  id           String           @id @default(cuid())
  userId       String
  name         String
  description  String?
  assetClass   String?
  traderStyle  String?
  minScore     Float            @default(60)
  isPublic     Boolean          @default(false)
  isPinned     Boolean          @default(false)
  useCount     Int              @default(0)
  forkCount    Int              @default(0)
  forkedFromId String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  runs         ScreenerRun[]
  signals      ScreenerSignal[]
  user         User             @relation("UserScreeners", fields: [userId], references: [id])
}

model ScreenerSignal {
  id         String           @id @default(cuid())
  templateId String
  sortOrder  Int              @default(0)
  dataSource String
  metric     String
  operator   String
  valueA     Float
  valueB     Float?
  unit       String?
  weight     Int              @default(1)
  isRequired Boolean          @default(false)
  notes      String?
  createdAt  DateTime         @default(now())
  template   ScreenerTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model ScreenerRun {
  id           String           @id @default(cuid())
  templateId   String
  userId       String
  assets       String
  results      String
  flaggedCount Int              @default(0)
  ranAt        DateTime         @default(now())
  template     ScreenerTemplate @relation(fields: [templateId], references: [id])
}

model ScreenerFork {
  id         String   @id @default(cuid())
  originalId String
  forkedById String
  forkedAt   DateTime @default(now())
}

model PropFirmReferral {
  id         String   @id @default(cuid())
  userId     String
  firmName   String
  firmSlug   String
  status     String   @default("pending")
  referredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  notes      String?
  user       User     @relation("PropFirmReferrals", fields: [userId], references: [id])
}

model LeaderboardSnapshot {
  id          String   @id @default(cuid())
  userId      String
  period      String
  periodKey   String
  assetClass  String
  rank        Int
  score       Float
  winRate     Float
  avgRR       Float
  totalTrades Int
  snappedAt   DateTime @default(now())
  user        User     @relation("LeaderboardSnapshots", fields: [userId], references: [id])
}

model TradeIdea {
  id           String   @id @default(cuid())
  authorId     String
  groupId      String?
  asset        String
  symbol       String
  direction    String
  entryPrice   Float?
  stopPrice    Float?
  targetPrice  Float?
  currentPrice Float?
  thesis       String
  cotIndex     Float?
  seasonalBias Float?
  status       String   @default("open")
  likes        Int      @default(0)
  createdAt    DateTime @default(now())
  author       User     @relation("AuthoredIdeas", fields: [authorId], references: [id], onDelete: Cascade)
  group        Group?   @relation(fields: [groupId], references: [id])
}
