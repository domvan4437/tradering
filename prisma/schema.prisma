generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  h2hChallenges   H2HMatch[] @relation("H2HChallenger")
  h2hOpponents    H2HMatch[] @relation("H2HOpponent")
  consistency     TraderConsistency?
  id                 String    @id @default(cuid())
  email              String    @unique
  password           String
  name               String?
  username           String?   @unique
  bio                String?
  createdAt          DateTime  @default(now())
  stripeCustomerId   String?   @unique
  subscriptionId     String?   @unique
  subscriptionStatus String?
  plan               String    @default("free")
  trialEndsAt        DateTime?
  screeningsToday    Int       @default(0)
  screeningsReset    DateTime  @default(now())
  isPublic           Boolean   @default(false)

  screenings    Screening[]
  watchlist     WatchlistItem[]
  alerts        Alert[]
  positions     Position[]
  ideas         Idea[]
  priceAlerts   PriceAlert[]
  posts         CommunityPost[]
  checklists    Checklist[]
  notes         Note[]
  tradeMedia    TradeMedia[]
  weeklyReviews WeeklyReview[]
  aiConversations AIConversation[]
  calendarNotes   CalendarNote[]
  cotAlerts       COTAlert[]
  tradePlans      TradePlan[]
  socialPosts     SocialPost[]
  socialComments  SocialComment[]
  postLikes       PostLike[]
  sentMessages    DirectMessage[]  @relation("SentMessages")
  receivedMessages DirectMessage[] @relation("ReceivedMessages")
  followers       UserFollow[]     @relation("Followers")
  following       UserFollow[]     @relation("Following")
  ownedGroups     Group[]          @relation("OwnedGroups")
  groupMembers    GroupMember[]
  groupMessages   GroupMessage[]
  createdTournaments Tournament[] @relation("CreatedTournaments")
  tournamentEntries  TournamentEntry[]
  tradeCalls         TradeCall[]
  brokerConnections  BrokerConnection[]
  brokerTrades       BrokerTrade[]
  groupMemberships   GroupMembership[]
  creatorPayouts     CreatorPayout[]
  tradeIdeas         TradeIdea[]      @relation("AuthoredIdeas")
  theme         String   @default("dark-gold")
  dashboardLayout Json?
  customFields  Json?
}

model Screening {
  id              String   @id @default(cuid())
  userId          String
  commodity       String
  direction       String?
  passed          Boolean
  stageFailed     String?
  stagesCompleted Int
  price           String?
  notes           String?
  outcome         String?
  pnl             Float?
  marketData      Json?
  results         Json?
  tags            String[]
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  commodity String
  notes     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, commodity])
}

model Alert {
  id        String    @id @default(cuid())
  userId    String
  type      String
  enabled   Boolean   @default(true)
  lastSent  DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Position {
  id            String    @id @default(cuid())
  userId        String
  symbol        String
  name          String
  direction     String    // LONG or SHORT
  entryPrice    Float
  currentPrice  Float?
  stopPrice     Float?
  targetPrice   Float?
  contracts     Int       @default(1)
  contractSize  Float     @default(1)
  status        String    @default("open") // open, closed
  exitPrice     Float?
  exitDate      DateTime?
  pnl           Float?
  notes         String?
  tags          String[]
  openedAt      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Idea {
  id          String   @id @default(cuid())
  userId      String
  title       String
  symbol      String?
  direction   String?  // BUY, SELL, WATCHING
  timeframe   String?  // Daily, Weekly, Monthly
  status      String   @default("watching") // watching, active, passed, invalid
  thesis      String?
  entry       String?
  stop        String?
  target      String?
  confidence  Int?     // 1-10
  tags        String[]
  isPublic    Boolean  @default(false)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PriceAlert {
  id          String    @id @default(cuid())
  userId      String
  symbol      String
  name        String
  condition   String    // above, below, cotIndex_above, cotIndex_below, seasonal_window
  value       Float?
  message     String?
  triggered   Boolean   @default(false)
  triggeredAt DateTime?
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommunityPost {
  id          String   @id @default(cuid())
  userId      String
  symbol      String
  direction   String?
  title       String
  body        String?
  passed      Boolean?
  cotIndex    Int?
  seasonal    Float?
  likes       Int      @default(0)
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Checklist {
  id        String          @id @default(cuid())
  userId    String
  name      String
  items     ChecklistItem[]
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  label       String
  order       Int       @default(0)
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String   @default("")
  tags      String[]
  isPinned  Boolean  @default(false)
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TradeMedia {
  id          String   @id @default(cuid())
  userId      String
  screeningId String?
  positionId  String?
  url         String
  caption     String?
  type        String   @default("image")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeeklyReview {
  id           String   @id @default(cuid())
  userId       String
  weekOf       DateTime
  whatWorked   String?
  whatDidnt    String?
  biggestLesson String?
  nextWeekFocus String?
  mentalState  String?
  rulesFollowed Int?
  totalTrades  Int?
  pnl          Float?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIConversation {
  id        String        @id @default(cuid())
  userId    String
  title     String        @default("New Conversation")
  messages  AIMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model CalendarNote {
  id        String   @id @default(cuid())
  userId    String
  date      String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model COTAlert {
  id          String    @id @default(cuid())
  userId      String
  commodity   String
  condition   String    // above, below
  threshold   Int       // 0-100 COT index value
  label       String?
  enabled     Boolean   @default(true)
  triggered   Boolean   @default(false)
  triggeredAt DateTime?
  lastChecked DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TradePlan {
  id          String   @id @default(cuid())
  userId      String
  commodity   String
  direction   String
  entry       String?
  stop        String?
  target      String?
  riskReward  String?
  thesis      String?
  cotContext  String?
  seasonalContext String?
  status      String   @default("active") // active, executed, cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Social / Community ─────────────────────────────────────────
model SocialPost {
  id          String        @id @default(cuid())
  userId      String
  content     String
  imageUrl    String?
  assetTag    String?       // e.g. "Gold", "EUR/USD"
  direction   String?       // LONG, SHORT, NEUTRAL
  likes       Int           @default(0)
  reposts     Int           @default(0)
  isPublic    Boolean       @default(true)
  groupId     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments    SocialComment[]
  postLikes   PostLike[]
}

model SocialComment {
  id        String      @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime    @default(now())
  post      SocialPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PostLike {
  id        String     @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime   @default(now())
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([postId, userId])
}

model DirectMessage {
  id          String   @id @default(cuid())
  fromUserId  String
  toUserId    String
  content     String
  imageUrl    String?
  fileUrl     String?
  fileName    String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  fromUser    User     @relation("SentMessages",     fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User     @relation("ReceivedMessages", fields: [toUserId],   references: [id], onDelete: Cascade)
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Followers",  fields: [followerId],  references: [id], onDelete: Cascade)
  following   User     @relation("Following",  fields: [followingId], references: [id], onDelete: Cascade)
  @@unique([followerId, followingId])
}

// ── Groups (Skool/Discord style) ───────────────────────────────
model Group {
  id          String        @id @default(cuid())
  ownerId     String
  name        String
  slug        String        @unique
  description String?
  imageUrl    String?
  price       Float         @default(0)   // 0 = free
  currency    String        @default("usd")
  platformFee Float         @default(0.05) // 5% to TradeRing
  isPublic    Boolean       @default(true)
  memberCount Int           @default(0)
  category    String?       // "Futures", "Forex", etc.
  createdAt   DateTime      @default(now())
  monthlyPrice Float         @default(0)
  isPrivate    Boolean       @default(false)
  owner       User          @relation("OwnedGroups", fields: [ownerId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  channels    GroupChannel[]
  courses     GroupCourse[]
  memberships GroupMembership[]
  tradeIdeas  TradeIdea[]
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  role      String   @default("member") // member, moderator, owner
  joinedAt  DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([groupId, userId])
}

model GroupChannel {
  id        String         @id @default(cuid())
  groupId   String
  name      String
  type      String         @default("chat") // chat, announcements
  order     Int            @default(0)
  createdAt DateTime       @default(now())
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  messages  GroupMessage[]
}

model GroupMessage {
  id        String       @id @default(cuid())
  channelId String
  userId    String
  content   String
  imageUrl  String?
  createdAt DateTime     @default(now())
  channel   GroupChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GroupCourse {
  id          String        @id @default(cuid())
  groupId     String
  title       String
  description String?
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  group       Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lessons     CourseLesson[]
}

model CourseLesson {
  id          String      @id @default(cuid())
  courseId    String
  title       String
  content     String      @default("")
  videoUrl    String?
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  course      GroupCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

// ── Competitions ───────────────────────────────────────────────
model Tournament {
  // Trade filter fields
  traderStyle      String?   // scalper | daytrader | swing | position | macro
  minHoldHours     Int?      // minimum hours a trade must be held
  maxHoldHours     Int?      // maximum hours a trade must be held
  maxTradesPerWeek Int?      // cap on trades submitted per week per user
  minRiskReward    Float?    // e.g. 1.5 means R:R must be >= 1.5
  maxRiskPct       Float?    // max % risk per trade (e.g. 3.0 = 3%)
  allowedAssets    String?   // JSON array of allowed symbols, null = all
  requireStopLoss  Boolean   @default(true)
  requireTarget    Boolean   @default(true)
  h2hMatches      H2HMatch[]
  // Trade filter fields

  id            String    @id @default(cuid())
  creatorId     String
  name          String
  description   String?
  type          String    @default("tournament") // tournament, h2h
  status        String    @default("open")       // open, active, completed, cancelled
  assetClasses  String[]  // ["commodities","forex","stocks","any"]
  maxCallsPerDay Int      @default(3)
  startDate     DateTime
  endDate       DateTime
  buyIn         Float     @default(0)
  prizePool     Float     @default(0)
  payoutStructure Json?   // [{place:1,pct:50},{place:2,pct:30},{place:3,pct:20}]
  maxTeams      Int?
  minTeams      Int       @default(2)
  platformFee   Float     @default(0.05)
  createdAt     DateTime  @default(now())
  creator       User      @relation("CreatedTournaments", fields: [creatorId], references: [id], onDelete: Cascade)
  entries       TournamentEntry[]
  calls         TradeCall[]
}


model H2HMatch {
  id              String   @id @default(cuid())
  tournamentId    String
  tournament      Tournament @relation(fields: [tournamentId], references: [id])
  challengerId    String
  challenger      User     @relation("H2HChallenger", fields: [challengerId], references: [id])
  opponentId      String?
  opponent        User?    @relation("H2HOpponent", fields: [opponentId], references: [id])
  status          String   @default("waiting") // waiting | active | completed
  winnerId        String?
  challengerScore Float    @default(0)
  opponentScore   Float    @default(0)
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime @default(now())
}

model TraderConsistency {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  totalTrades     Int      @default(0)
  winRate         Float    @default(0)
  avgRR           Float    @default(0)
  avgHoldHours    Float    @default(0)
  traderStyle     String?
  consistencyScore Float   @default(0)
  lastUpdated     DateTime @default(now())
}

model TournamentEntry {
  id           String     @id @default(cuid())
  tournamentId String
  groupId      String?
  userId       String     // captain / solo entry
  teamName     String?
  score        Float      @default(0)
  rank         Int?
  paid         Boolean    @default(false)
  paidOut            Boolean    @default(false)
  totalDollarPnL     Float      @default(0)
  autoBrokerSync     Boolean    @default(false)  // user chooses per competition
  joinedAt           DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  calls        TradeCall[]
  @@unique([tournamentId, userId])
}

model TradeCall {
  // Validation fields
  entryTimestamp   DateTime? // when trade was officially entered
  closeTimestamp   DateTime? // when trade was closed
  holdHours        Float?    // calculated hold duration
  stopLoss         Float?
  takeProfit       Float?
  riskPct          Float?

  validationStatus String    @default("pending") // pending | valid | disqualified
  disqualReason    String?
  consistencyDelta Float?    // how much this trade moved consistency score
  // Validation fields

  id              String           @id @default(cuid())
  entryId         String
  tournamentId    String
  userId          String
  asset           String
  symbol          String
  direction       String           // LONG, SHORT
  entryPrice      Float
  stopPrice       Float
  targetPrice     Float
  currentPrice    Float?
  contractSize    Float            @default(1)
  contracts       Int              @default(1)
  dollarRisk      Float?           // calculated: |entry-stop| * contractSize * contracts
  dollarTarget    Float?           // calculated: |target-entry| * contractSize * contracts
  dollarPnL       Float?           // actual dollar P&L when resolved
  isRealMoney     Boolean          @default(false)
  status          String           @default("open") // open, won, lost, expired
  rMultiple       Float?
  points          Float            @default(0)
  submittedAt     DateTime         @default(now())
  resolvedAt      DateTime?
  expiresAt       DateTime?
  entry           TournamentEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tournament      Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Broker Integrations ────────────────────────────────────────
model BrokerConnection {
  id            String    @id @default(cuid())
  userId        String
  broker        String    // tradovate, ibkr, alpaca, schwab
  label         String?   // user-set nickname e.g. "My Futures Account"
  apiKey        String?   // encrypted in production
  apiSecret     String?
  accountId     String?
  accessToken   String?
  refreshToken  String?
  tokenExpiry   DateTime?
  status        String    @default("connected") // connected, error, disconnected
  lastSynced    DateTime?
  autoCompete   Boolean   @default(true)  // auto-enter trades into competitions
  showPnL       Boolean   @default(false) // show real P&L publicly
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerTrades  BrokerTrade[]
}

model BrokerTrade {
  id              String           @id @default(cuid())
  connectionId    String
  userId          String
  brokerTradeId   String           // original ID from broker
  asset           String
  symbol          String
  direction       String           // LONG, SHORT
  entryPrice      Float
  exitPrice       Float?
  stopPrice       Float?
  targetPrice     Float?
  quantity        Float            @default(1)
  contractSize    Float            @default(1)
  realizedPnL     Float?
  status          String           @default("open") // open, closed
  openedAt        DateTime
  closedAt        DateTime?
  tradeCallId     String?          // linked competition call if auto-entered
  createdAt       DateTime         @default(now())
  connection      BrokerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([connectionId, brokerTradeId])
}

// ── Creator Economy ────────────────────────────────────────────────
model GroupMembership {
  id          String   @id @default(cuid())
  groupId     String
  userId      String
  monthlyFee  Float    @default(0)
  status      String   @default("active") // active, cancelled, past_due
  joinedAt    DateTime @default(now())
  renewsAt    DateTime?
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([groupId, userId])
}

model CreatorPayout {
  id          String   @id @default(cuid())
  creatorId   String
  amount      Float
  type        String   // membership_fee, tournament_hosting, course_sale
  sourceId    String?  // groupId or tournamentId
  description String?
  paidOut     Boolean  @default(false)
  createdAt   DateTime @default(now())
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

model TradeIdea {
  id          String   @id @default(cuid())
  authorId    String
  groupId     String?
  asset       String
  symbol      String
  direction   String   // LONG, SHORT, NEUTRAL
  entryPrice  Float?
  stopPrice   Float?
  targetPrice Float?
  currentPrice Float?
  thesis      String
  cotIndex    Float?
  seasonalBias Float?
  status      String   @default("open") // open, hit_target, hit_stop, closed
  likes       Int      @default(0)
  createdAt   DateTime @default(now())
  author      User     @relation("AuthoredIdeas", fields: [authorId], references: [id], onDelete: Cascade)
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
}
